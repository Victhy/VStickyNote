<Window x:Class="VSticky.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="便签"
        Width="260" Height="220"
        MinWidth="160" MinHeight="70"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="False"
        Cursor="Arrow"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        LostMouseCapture="Window_LostMouseCapture"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            BorderThickness="0"
            CornerRadius="12"
            Background="#EBC8E6C9"
            Cursor="Arrow"
            MouseRightButtonUp="Root_MouseRightButtonUp">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="12">
                <!-- 预览：Markdown 渲染 -->
                <FlowDocumentScrollViewer x:Name="PreviewViewer"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsToolBarVisible="False"
                                          Background="Transparent"
                                          Focusable="False"
                                          Cursor="Arrow"
                                          PreviewMouseLeftButtonDown="Preview_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="Preview_PreviewMouseMove"
                                          PreviewMouseLeftButtonUp="Preview_PreviewMouseLeftButtonUp"
                                          PreviewMouseRightButtonUp="Root_MouseRightButtonUp"/>

                <!-- 编辑：Markdown 源码 -->
                <TextBox x:Name="BodyBox"
                         Visibility="Collapsed"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Hidden"
                         HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Background="Transparent"
                         CaretBrush="#DD000000"
                         Foreground="#DD000000"
                         FontSize="14"
                         FontFamily="Microsoft YaHei UI"
                         Cursor="IBeam"
                         InputMethod.IsInputMethodEnabled="True"
                         TextChanged="BodyBox_TextChanged"
                         PreviewMouseRightButtonUp="Root_MouseRightButtonUp"
                         LostKeyboardFocus="BodyBox_LostKeyboardFocus"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="Transparent"
                    Padding="12,0,12,10"
                    Visibility="Collapsed"
                    x:Name="QuickPanel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OpacityLabel"
                               Text="透明"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#99000000"
                               Margin="0,0,6,0"/>
                    <Slider x:Name="OpacitySlider" Grid.Column="1"
                            Minimum="0.2" Maximum="1" Value="0.92"
                            VerticalAlignment="Center"
                            ValueChanged="OpacitySlider_ValueChanged"/>
                    <TextBlock x:Name="CornerLabel"
                               Text="圆角"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#99000000"
                               Margin="8,0,6,0"/>
                    <Slider x:Name="RadiusSlider" Grid.Column="3"
                            Minimum="0" Maximum="28" Value="12"
                            VerticalAlignment="Center"
                            ValueChanged="RadiusSlider_ValueChanged"/>
                </Grid>
            </Border>
        </Grid>
    </Border>

    <Window.ContextMenu>
        <ContextMenu x:Name="NoteMenu" Style="{StaticResource NoteContextMenu}">
            <MenuItem x:Name="NewNoteMenuItem"
                      Header="新建便签"
                      Style="{StaticResource NoteMenuItem}"
                      Click="NewNote_Click"/>
            <Separator Style="{StaticResource NoteSeparator}"/>
            <MenuItem Header="颜色" x:Name="ColorMenu" Style="{StaticResource NoteMenuItem}"/>
            <MenuItem Header="字体" x:Name="FontMenu" Style="{StaticResource NoteMenuItem}"/>
            <MenuItem Header="字号" x:Name="FontSizeMenu" Style="{StaticResource NoteMenuItem}"/>
            <MenuItem x:Name="AdjustMenuItem"
                      Header="调节透明/圆角"
                      Style="{StaticResource NoteMenuItem}"
                      Click="ToggleQuickPanel_Click"/>
            <MenuItem x:Name="TopmostMenu"
                      Header="钉在桌面（置顶）"
                      Style="{StaticResource NoteMenuItem}"
                      IsCheckable="True"
                      IsChecked="False"
                      Click="Topmost_Click"/>
            <Separator Style="{StaticResource NoteSeparator}"/>
            <MenuItem x:Name="HideNoteMenuItem"
                      Header="隐藏便签"
                      Style="{StaticResource NoteMenuItem}"
                      Click="HideNote_Click"/>
            <Separator Style="{StaticResource NoteSeparator}"/>
            <MenuItem x:Name="DeleteMenuItem"
                      Header="删除便签"
                      Style="{StaticResource NoteMenuItem.Danger}"
                      Click="Delete_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
</Window>
